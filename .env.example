NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Marketaux — main news feed, trending tickers/countries, sentiment
# (server-side only — never use NEXT_PUBLIC_ prefix)
MARKETAUX_API_KEY=your_marketaux_api_key_here

# Supabase service role key — server-side only, NEVER use NEXT_PUBLIC_ prefix
# and never expose to the client. Bypasses Row Level Security; required for
# the account-deletion API route (src/app/api/account/delete). Find it in
# the Supabase dashboard: Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Anthropic — AI article summaries (server-side only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Sentry — production error monitoring. The DSN is not secret (it's baked
# into the client bundle either way), so NEXT_PUBLIC_ is correct here.
# Find it in Sentry: Settings → Projects → (project) → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
